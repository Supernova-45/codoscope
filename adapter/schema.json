{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BioJ-Space DeCodon atlas document",
  "type": "object",
  "required": [
    "schema_version",
    "model",
    "sequence_id",
    "organism_default",
    "organisms",
    "tokens",
    "per_organism",
    "concept_layers"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^biojspace/[^/]+-[0-9]+\\.[0-9]+$"
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "n_layers",
        "hidden_size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "n_layers": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sequence_id": {
      "type": "string"
    },
    "organism_default": {
      "type": "string"
    },
    "organisms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pos",
          "codon",
          "aa",
          "aa3",
          "frame"
        ],
        "properties": {
          "pos": {
            "type": "integer"
          },
          "codon": {
            "type": "string",
            "pattern": "^[ACGT]{3}$"
          },
          "aa": {
            "type": "string"
          },
          "aa3": {
            "type": "string"
          },
          "frame": {
            "type": "integer"
          }
        }
      },
      "minItems": 1
    },
    "per_organism": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pos",
            "aa_readout",
            "synonym_readout",
            "aa_confidence",
            "synonym_entropy",
            "true_codon",
            "true_aa"
          ],
          "properties": {
            "pos": {
              "type": "integer"
            },
            "aa_readout": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/readout"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "aa_mean"
                      }
                    }
                  }
                ]
              }
            },
            "synonym_readout": {
              "type": "array",
              "items": {
                "allOf": [
                  {
                    "$ref": "#/definitions/readout"
                  },
                  {
                    "properties": {
                      "kind": {
                        "const": "codon"
                      }
                    }
                  }
                ]
              }
            },
            "aa_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "synonym_entropy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "true_codon": {
              "type": "string"
            },
            "true_aa": {
              "type": "string"
            },
            "predicted_aa": {
              "type": "string"
            }
          }
        }
      }
    },
    "concept_layers": {
      "type": "object",
      "required": [
        "layers",
        "concepts"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "concepts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind",
              "baseline",
              "scores"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "clf",
                  "reg"
                ]
              },
              "baseline": {
                "type": "number"
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "lens": {
      "$ref": "#/definitions/lens"
    }
  },
  "definitions": {
    "readout": {
      "type": "object",
      "required": [
        "label",
        "kind",
        "score"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "aa_mean",
            "codon",
            "derived",
            "sae",
            "phenotype"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "rankedReadout": {
      "allOf": [
        {
          "$ref": "#/definitions/readout"
        },
        {
          "type": "object",
          "required": [
            "rank"
          ],
          "properties": {
            "rank": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "lens": {
      "type": "object",
      "required": [
        "method",
        "status",
        "layers",
        "top_k",
        "model_revision",
        "score_units",
        "normalization",
        "source_position",
        "target_positions",
        "per_organism",
        "rank_tracks"
      ],
      "properties": {
        "method": {
          "enum": [
            "logit_lens",
            "jacobian_lens"
          ]
        },
        "status": {
          "enum": [
            "baseline",
            "validated",
            "development"
          ]
        },
        "layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "model_revision": {
          "type": "string",
          "minLength": 1
        },
        "lens_revision": {
          "type": "string"
        },
        "score_units": {
          "const": "probability"
        },
        "normalization": {
          "type": "string",
          "minLength": 1
        },
        "source_position": {
          "type": "string",
          "minLength": 1
        },
        "target_positions": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "type": "object",
          "required": [
            "corpus_manifest",
            "n_sequences",
            "skip_first"
          ],
          "properties": {
            "corpus_manifest": {
              "type": "string"
            },
            "n_sequences": {
              "type": "integer",
              "minimum": 1
            },
            "skip_first": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "per_organism": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "pos",
                "layers"
              ],
              "properties": {
                "pos": {
                  "type": "integer",
                  "minimum": 0
                },
                "layers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "layer",
                      "pos",
                      "aa_readout",
                      "codon_readout"
                    ],
                    "properties": {
                      "layer": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "pos": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "aa_readout": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/rankedReadout"
                        }
                      },
                      "codon_readout": {
                        "type": "array",
                        "items": {
                          "$ref": "#/definitions/rankedReadout"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "rank_tracks": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}