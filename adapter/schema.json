{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BioJ-Space DeCodon atlas document",
  "type": "object",
  "required": [
    "schema_version",
    "model",
    "sequence_id",
    "organisms",
    "tokens",
    "per_organism"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^biojspace/[^/]+-[0-9]+\\.[0-9]+$"
    },
    "model": {
      "type": "object",
      "required": [
        "name",
        "n_layers",
        "hidden_size"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "n_layers": {
          "type": "integer",
          "minimum": 1
        },
        "hidden_size": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sequence_id": {
      "type": "string"
    },
    "organism_default": {
      "type": "string"
    },
    "organisms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "pos",
          "codon",
          "aa"
        ],
        "properties": {
          "pos": {
            "type": "integer"
          },
          "codon": {
            "type": "string",
            "pattern": "^[ACGT]{3}$"
          },
          "aa": {
            "type": "string"
          },
          "aa3": {
            "type": "string"
          },
          "frame": {
            "type": "integer"
          }
        }
      },
      "minItems": 1
    },
    "per_organism": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pos",
            "aa_readout",
            "synonym_readout"
          ],
          "properties": {
            "pos": {
              "type": "integer"
            },
            "aa_readout": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/readout"
              }
            },
            "synonym_readout": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/readout"
              }
            },
            "aa_confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "synonym_entropy": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "true_codon": {
              "type": "string"
            },
            "true_aa": {
              "type": "string"
            }
          }
        }
      }
    },
    "concept_layers": {
      "type": "object",
      "required": [
        "layers",
        "concepts"
      ],
      "properties": {
        "layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "concepts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "kind",
              "baseline",
              "scores"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "clf",
                  "reg"
                ]
              },
              "baseline": {
                "type": "number"
              },
              "scores": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "readout": {
      "type": "object",
      "required": [
        "label",
        "kind",
        "score"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "aa_mean",
            "codon",
            "derived",
            "sae",
            "phenotype"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}